# Copy to .env in backend/. Never commit secrets.
ZPERMIT_DATABASE_URL=sqlite:///./zpermit.db
# JSON array of explicit HTTP(S) origins; an empty array disables browser access.
ZPERMIT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LOCAL DEVELOPMENT ONLY. Both credentials must be nonempty and different.
# Generate independent random values locally; never commit real credentials.
# Blank defaults intentionally disable every spending API route (HTTP 503).
ZPERMIT_DEV_OWNER_ID=development-owner
ZPERMIT_DEV_AGENT_ID=shopping-agent
ZPERMIT_DEV_OWNER_CREDENTIAL=
ZPERMIT_DEV_AGENT_CREDENTIAL=

# Server-side Bitrefill account API key, sent ONLY as Authorization: Bearer.
# OAuth guest accounts and invoice access-token storage are not implemented.
BITREFILL_API_KEY=REPLACE_WITH_PRIVATE_LOCAL_VALUE
# Safety switch; enabling it alone DOES NOT bypass the unverified quote contract.
BITREFILL_LIVE_PURCHASES_ENABLED=false
ZPERMIT_BITREFILL_TIMEOUT_SECONDS=10
ZPERMIT_BITREFILL_PREVIEW_TTL_SECONDS=60

# Milestone 4: dedicated public NU7 testnet wallet only (never mainnet).
# Obtain a matching Zallet beta.4 + Zebra 7 toolchain; see docs/zcash-testnet.md.
ZPERMIT_ZCASH_NETWORK=test
ZPERMIT_ZCASH_ENABLED=false
ZPERMIT_ZCASH_LIVE_BROADCAST_ENABLED=false
ZPERMIT_ZCASH_ZALLET_BINARY=/usr/local/bin/zallet
ZPERMIT_ZCASH_ZALLET_CONFIG=
ZPERMIT_ZCASH_ZALLET_DATADIR=
ZPERMIT_ZCASH_ZEBRA_RPC_URL=http://127.0.0.1:18232
ZPERMIT_ZCASH_ACCOUNT_ID=
ZPERMIT_ZCASH_SOURCE_ADDRESS=
ZPERMIT_ZCASH_TIMEOUT_SECONDS=15
ZPERMIT_ZCASH_REQUEST_TTL_SECONDS=300

# Optional public lightwallet verification; independent of Zallet flags.
# Reuses Zingo GUI receiving/signing without opening its private wallet files.
ZPERMIT_ZCASH_PUBLIC_READS_ENABLED=false
ZPERMIT_ZCASH_PUBLIC_RECEIVING_ADDRESS=
# Optional absolute override; default is the compiled tool inside backend/tools.
# ZPERMIT_ZCASH_PUBLIC_INSPECTOR_BINARY=/absolute/path/to/zpermit-public-inspect

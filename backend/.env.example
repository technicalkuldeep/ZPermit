# Copy to .env in backend/. Never commit secrets.
ZPERMIT_DATABASE_URL=sqlite:///./zpermit.db
# JSON array of explicit HTTP(S) origins; an empty array disables browser access.
ZPERMIT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LOCAL DEVELOPMENT ONLY. Both credentials must be nonempty and different.
# Generate independent random values locally; never commit real credentials.
# Blank defaults intentionally disable every spending API route (HTTP 503).
ZPERMIT_DEV_OWNER_ID=development-owner
ZPERMIT_DEV_AGENT_ID=shopping-agent
ZPERMIT_DEV_OWNER_CREDENTIAL=
ZPERMIT_DEV_AGENT_CREDENTIAL=
